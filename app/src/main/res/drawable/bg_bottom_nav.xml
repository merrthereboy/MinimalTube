<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top divider border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#262633" />
        </shape>
    </item>
    <!-- Background layer placed 1dp below top to create border -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#18181F" />
        </shape>
    </item>
</layer-list>
