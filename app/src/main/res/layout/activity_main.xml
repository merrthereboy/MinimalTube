<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Luxury Header Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/imgBrandLogo"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logo_full" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnToggleSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_title" />
    </LinearLayout>

    <!-- Filter Chips Carousel (Only on Home tab) -->
    <HorizontalScrollView
        android:id="@+id/chipsScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_chip_active"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Tất cả"
                android:textColor="@color/pill_active_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipLive"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Trực tiếp"
                android:textColor="@color/pill_inactive_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipMusic"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Âm nhạc"
                android:textColor="@color/pill_inactive_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipGaming"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Trò chơi"
                android:textColor="@color/pill_inactive_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipNews"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Tin tức"
                android:textColor="@color/pill_inactive_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipTech"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Công nghệ"
                android:textColor="@color/pill_inactive_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipTrending"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Thịnh hành"
                android:textColor="@color/pill_inactive_text"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Search Input Area -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/edtSearchQuery"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:hint="Tìm kiếm video hoặc kênh..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnDoSearch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_chip_active"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="TÌM"
            android:textColor="@color/pill_active_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Full Video Player Section with Gestures & HUD -->
    <LinearLayout
        android:id="@+id/playerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Player View (TextureView with NO background for crisp video playback) -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:resize_mode="fit"
                    app:show_buffering="when_playing"
                    app:surface_type="texture_view"
                    app:use_controller="true" />

                <!-- Volume Gesture HUD Overlay -->
                <LinearLayout
                    android:id="@+id/hudVolume"
                    android:layout_width="140dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_card_surface"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtVolumePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Âm lượng: 50%"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressVolume"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/active_accent" />
                </LinearLayout>

                <!-- Brightness Gesture HUD Overlay -->
                <LinearLayout
                    android:id="@+id/hudBrightness"
                    android:layout_width="140dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_card_surface"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtBrightnessPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Độ sáng: 50%"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressBrightness"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:max="100"
                        android:progress="50"
                        android:progressTint="@color/accent_peach" />
                </LinearLayout>

                <!-- Double Tap Seek HUD Overlay -->
                <LinearLayout
                    android:id="@+id/hudSeek"
                    android:layout_width="130dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_card_surface"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtSeekText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+10 giây ▶▶"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Top Corner Controls (Quality & Minimize) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:orientation="horizontal">

                    <!-- Quality Selector Button -->
                    <TextView
                        android:id="@+id/btnPlayerQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_pill_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="1080p"
                        android:textColor="@color/text_white"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Speed Selector Button -->
                    <TextView
                        android:id="@+id/btnPlayerSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_chip_inactive"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="1.0x"
                        android:textColor="@color/text_white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Player Controls & Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCurrentPlayingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCurrentPlayingChannel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="@color/active_accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Nút Mở Bình Luận -->
            <TextView
                android:id="@+id/btnOpenComments"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_pill_secondary"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="💬 Bình luận"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />

            <!-- Nút Thu nhỏ Miniplayer -->
            <ImageView
                android:id="@+id/btnMinimizePlayer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_shorts"
                app:tint="@color/text_sub" />

            <!-- Nút Đóng Trình Phát -->
            <ImageView
                android:id="@+id/btnClosePlayer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close_clean"
                app:tint="@color/text_sub" />
        </LinearLayout>
    </LinearLayout>

    <!-- Docked Mini-Player Bar (when minimized) -->
    <LinearLayout
        android:id="@+id/miniPlayerSection"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card_surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_shorts"
            app:tint="@color/active_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtMiniPlayerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_title"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMiniPlayerChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_sub"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnMiniPlayerPlayPause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_shorts"
            app:tint="@color/text_white" />

        <ImageView
            android:id="@+id/btnMiniPlayerClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_close_clean"
            app:tint="@color/text_sub" />
    </LinearLayout>

    <!-- Status / Loading Notification -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="ĐANG TẢI DỮ LIỆU..."
        android:textColor="@color/text_sub"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Main Content Frame (5 Tabs Container) -->
    <FrameLayout
        android:id="@+id/tabContentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: TRANG CHỦ -->
        <LinearLayout
            android:id="@+id/tabContentHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="20dp" />
        </LinearLayout>

        <!-- TAB 2: SHORTS (Vertical ViewPager2) -->
        <FrameLayout
            android:id="@+id/tabContentShorts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerShorts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />
        </FrameLayout>

        <!-- TAB 3: FANS ZONE (KÊNH ĐĂNG KÝ) -->
        <LinearLayout
            android:id="@+id/tabContentSubscriptions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Card Khi Chưa Đăng Nhập -->
            <LinearLayout
                android:id="@+id/cardSubsNotLoggedIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_subscriptions"
                    app:tint="@color/active_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="KÊNH ĐÃ ĐĂNG KÝ (FANS ZONE)"
                    android:textColor="@color/text_title"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Đăng nhập Google để đồng bộ toàn bộ kênh đăng ký YouTube và xem cập nhật mới nhất từ các nhà sáng tạo yêu thích."
                    android:textColor="@color/text_sub"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/btnSubsLogin"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/gradient_brand_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_google" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="ĐĂNG NHẬP GOOGLE ĐỒNG BỘ"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Khi Đã Đăng Nhập: Hàng avatar kênh cuộn ngang + Danh sách video -->
            <LinearLayout
                android:id="@+id/layoutLoggedInSubs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewSubChannels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewSubs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="14dp"
                    android:paddingBottom="20dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- TAB 4: VIDEO CỦA TÔI (THƯ VIỆN & LỊCH SỬ) -->
        <ScrollView
            android:id="@+id/tabContentLibrary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/active_accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="LỊCH SỬ XEM GẦN ĐÂY"
                        android:textColor="@color/text_title"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnClearHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:text="XÓA"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Chưa có video nào trong lịch sử xem."
                    android:textColor="@color/text_sub"
                    android:textSize="11sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="DANH SÁCH &amp; BỘ SƯU TẬP"
                    android:textColor="@color/text_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_playlist"
                        app:tint="@color/active_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Video đã thích &amp; Đã lưu"
                            android:textColor="@color/text_title"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Truy cập nhanh các video yêu thích"
                            android:textColor="@color/text_sub"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- TAB 5: TÔI (CÁ NHÂN & CÀI ĐẶT) -->
        <ScrollView
            android:id="@+id/tabContentProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/active_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Khách (Chưa đồng bộ)"
                            android:textColor="@color/text_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtProfileStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Chưa kết nối tài khoản Google"
                            android:textColor="@color/text_sub"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnProfileGoogleLogin"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/gradient_brand_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_google" />

                    <TextView
                        android:id="@+id/txtProfileLoginAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="ĐỒNG BỘ TÀI KHOẢN GOOGLE"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CHẾ ĐỘ XEM"
                            android:textColor="@color/text_sub"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sạch 100%"
                            android:textColor="@color/active_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_surface"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐỘ PHÂN GIẢI"
                            android:textColor="@color/text_sub"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tự động (1080p)"
                            android:textColor="@color/text_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="THÔNG TIN &amp; CÀI ĐẶT"
                    android:textColor="@color/text_title"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_surface"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MinimalTube"
                        android:textColor="@color/text_title"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Phiên bản: v1.2.0 Pro Edition"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Nhà phát triển: Đoàn Tiến Đạt (merrthereboy)"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mã nguồn: github.com/merrthereboy/MinimalTube"
                        android:textColor="@color/active_accent"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Luxury Navigation Bar (5 Tabs) -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_bottom_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavHome"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home"
                app:tint="@color/active_accent" />

            <TextView
                android:id="@+id/txtNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="TRANG CHỦ"
                android:textColor="@color/active_accent"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navShorts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavShorts"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_shorts"
                app:tint="@color/inactive_nav" />

            <TextView
                android:id="@+id/txtNavShorts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="SHORTS"
                android:textColor="@color/inactive_nav"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSubs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavSubs"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_subscriptions"
                app:tint="@color/inactive_nav" />

            <TextView
                android:id="@+id/txtNavSubs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="FANS ZONE"
                android:textColor="@color/inactive_nav"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavLibrary"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_library"
                app:tint="@color/inactive_nav" />

            <TextView
                android:id="@+id/txtNavLibrary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="VIDEO CỦA TÔI"
                android:textColor="@color/inactive_nav"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconNavProfile"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/inactive_nav" />

            <TextView
                android:id="@+id/txtNavProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="TÔI"
                android:textColor="@color/inactive_nav"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
