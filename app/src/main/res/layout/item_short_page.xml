<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Video Preview or Background Thumbnail -->
    <ImageView
        android:id="@+id/imgShortThumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Gradient Vignette Overlay at bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="bottom"
        android:background="#A0000000" />

    <!-- Play/Pause Indicator Center -->
    <ImageView
        android:id="@+id/btnShortCenterPlay"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pill_inactive"
        android:padding="16dp"
        android:src="@drawable/ic_shorts"
        android:visibility="gone"
        app:tint="@color/text_white" />

    <!-- Right Interaction Sidebar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="70dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Channel Avatar -->
        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgShortAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/card_surface"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <!-- Nút Thích -->
        <TextView
            android:id="@+id/btnShortLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="❤"
            android:textColor="@color/text_white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/txtShortLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Thích"
            android:textColor="@color/text_white"
            android:textSize="10sp" />

        <!-- Nút Bình luận -->
        <ImageView
            android:id="@+id/btnShortComment"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_library"
            app:tint="@color/text_white" />

        <TextView
            android:id="@+id/txtShortCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Bình luận"
            android:textColor="@color/text_white"
            android:textSize="10sp" />

        <!-- Nút Phát / Xem đầy đủ -->
        <TextView
            android:id="@+id/btnShortPlayFull"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/active_accent"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Phát"
            android:textColor="@color/active_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Metadata: Channel + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtShortChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnShortSubscribe"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/gradient_brand_button"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="ĐĂNG KÝ"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtShortTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_white"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
